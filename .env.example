# Application
PROJECT_NAME=workchop-api
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=staging

# Server
SERVER_HOST=https://api.your-domain.com
SERVER_PORT=8000
API_HOST_PORT=8000

# Security (Generated automatically - change in production)
SECRET_KEY=6f72d30264680409d68f60ae7ee4b495a4d1ecdd7fe54768df8da23afa5a2749
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://your-frontend-domain.com"]

# Database (Docker service name)
DATABASE_URL=postgresql://user:password@db:5432/workchop_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis (Docker service name)
REDIS_URL=redis://redis:6379/0

# Email (Optional)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Your App Name

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=workchop
USE_CLOUDINARY=true
MAX_UPLOAD_SIZE_MB=5

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
PAYSTACK_BASE_URL=https://api.paystack.co

# Firebase Cloud Messaging
FCM_ENABLED=true
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# Host path on server to your Firebase service-account JSON
FCM_SERVICE_ACCOUNT_FILE_HOST=/opt/workchop/secrets/fcm-service-account.json

# Dojah hosted Identity widget (artisan NIN + selfie). Real keys go in the server env only, never in git.
DOJAH_ENVIRONMENT=sandbox
DOJAH_API_KEY=your-dojah-secret-key
DOJAH_APP_ID=your-dojah-app-id
DOJAH_PUBLIC_KEY=your-dojah-public-key
DOJAH_NIN_WIDGET_ID=your-nin-widget-id
DOJAH_WEBHOOK_SECRET=your-dojah-webhook-subscription-secret
DOJAH_BASE_URL=https://api.dojah.io

# Admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
