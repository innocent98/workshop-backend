{
  "request": {
    "method": "POST",
    "path": "/api/v1/payments/webhook",
    "headers": {
      "x-paystack-signature": "<hmac-sha512(PAYSTACK_WEBHOOK_SECRET, raw body)>",
      "content-type": "application/json"
    },
    "body": {
      "event": "charge.success",
      "data": {
        "reference": "PAY-CAP-MISMATCH",
        "status": "success",
        "amount": 100,
        "currency": "NGN",
        "channel": "card"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "status": "ignored",
      "message": "Amount or currency mismatch"
    }
  },
  "note": "amount differs from the stored payment: NOT settled (payment stays pending)"
}
