# ============================================================================
# Workchop API: staging environment  (TEMPLATE: every value below is a FAKE PLACEHOLDER)
# ============================================================================
# How to use:
#   cp .env.staging.example .env.staging     # plaintext: gitignored, never committed
#   edit the real values in .env.staging
#   ./scripts/env.sh encrypt staging         # -> .env.staging.enc (this one IS committed)
#   rm .env.staging                          # keep no plaintext copy lying around
# The deploy decrypts .env.staging.enc on the CI runner and ships it to the VPS as .env.
# Walkthrough: docs/deployment/OWNER-SETUP-CHECKLIST.md, encryption: docs/deployment/ENV_ENCRYPTION.md
#
# Format rules (the same file is read by docker compose, so keep it simple):
#   * one KEY=value per line, no `export`, no spaces around `=`
#   * JSON values (BACKEND_CORS_ORIGINS) and any value with spaces or shell-special
#     characters go in single quotes (the backup/restore scripts read this file too)
#   * generate random secrets with:  openssl rand -hex 32   (hex only: no escaping trouble)
# ============================================================================

# ---- Stack identity (read by docker compose + the backup scripts) ----------
# Container names become ${COMPOSE_PROJECT_NAME}_db / _api / _worker / _beat.
COMPOSE_PROJECT_NAME=workchop-staging
# Host port the API listens on (127.0.0.1 only; nginx proxies to it). Pick a port that
# is free on the VPS; staging and production on one VPS need different ports.
API_PORT=8001
# API_IMAGE is pinned by the deploy (ghcr.io/...@sha256:...). Do NOT set it here.

# ---- Database (the compose file builds DATABASE_URL from these) -------------
# DATABASE_URL and REDIS_URL are set by docker-compose.prod.yml; do not put them here.
POSTGRES_USER=workchop
# REQUIRED, left empty on purpose (compose refuses to start with an empty value): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=workchop_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---- Application -------------------------------------------------------------
PROJECT_NAME=workchop-api
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=staging
# Public base URL of this API (used in links/emails).
SERVER_HOST=https://staging-api.workchop.app
SERVER_PORT=8000
# Browser origins allowed by CORS. MUST be a JSON array in single quotes.
# (The mobile app does not use CORS; list only the web origins that call the API.)
BACKEND_CORS_ORIGINS='["https://staging.workchop.app"]'

# ---- Security -----------------------------------------------------------------
# NEW value for every environment (never reuse the dev/test value or the one in git).
SECRET_KEY=REPLACE_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ---- First admin (consumed by scripts/create_admin.py, run once by hand) ------
# Use a real mailbox you control and a strong password; rotate after first login.
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=REPLACE_strong_unique_password

# ---- Email (OTP + notifications). REQUIRED in practice: without SMTP, ----------
# ---- registration OTP emails are only logged and nobody can sign up. ----------
# SMTP_TLS=true  -> STARTTLS (usually port 587);  false -> implicit TLS (port 465).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=REPLACE_smtp_username
SMTP_PASSWORD=REPLACE_smtp_password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Workchop

# ---- Cloudinary (image uploads: profile + portfolio) ---------------------------
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=REPLACE_cloud_name
CLOUDINARY_API_KEY=REPLACE_api_key
CLOUDINARY_API_SECRET=REPLACE_api_secret
CLOUDINARY_FOLDER=workchop-staging
MAX_UPLOAD_SIZE_MB=5
# ALLOWED_IMAGE_EXTENSIONS='["jpg","jpeg","png","gif","webp"]'   # default; JSON if you override

# ---- Paystack -------------------------------------------------------------------
# TEST keys only (sk_test_/pk_test_). Never put live keys on staging.
PAYSTACK_SECRET_KEY=REPLACE_paystack_test_secret_key
PAYSTACK_PUBLIC_KEY=REPLACE_paystack_test_public_key
# IMPORTANT: Paystack signs webhooks with your SECRET KEY (there is no separate webhook
# secret). The app verifies with PAYSTACK_WEBHOOK_SECRET and REJECTS every webhook when it
# is empty, so set it to the SAME value as PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=REPLACE_paystack_test_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co
ESCROW_PROVIDER=paystack
PAYOUT_PROVIDER=paystack
COMPLETION_DISPUTE_WINDOW_HOURS=24
PLATFORM_COMMISSION_PERCENT=10.00
MIN_PAYOUT_NGN=5000.00

# ---- Dojah (artisan NIN + selfie verification) ----------------------------------
# sandbox keys only work on sandbox.dojah.io; real NIN lookups need production.
DOJAH_ENVIRONMENT=sandbox
DOJAH_API_KEY=REPLACE_dojah_secret_key
DOJAH_APP_ID=REPLACE_dojah_app_id
DOJAH_PUBLIC_KEY=REPLACE_dojah_public_key
DOJAH_NIN_WIDGET_ID=REPLACE_dojah_nin_widget_id
# Per-subscription secret shown when you subscribe the webhook in Dojah (NOT the API key).
DOJAH_WEBHOOK_SECRET=REPLACE_dojah_webhook_secret
DOJAH_BASE_URL=https://api.dojah.io
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_WINDOW_HOURS=24

# ---- Push notifications (Firebase Cloud Messaging) ---------------------------------
# The service-account JSON lives on the VPS only, outside git and the image. It is mounted
# read-only at /run/secrets/fcm-service-account.json (FCM_SERVICE_ACCOUNT_FILE is set by
# compose). The file MUST exist at FCM_SERVICE_ACCOUNT_FILE_HOST before the first deploy.
FCM_ENABLED=false
# Staging has its OWN path (and, if FCM is enabled there, its own Firebase project): staging must
# never mount or send pushes with the production service account. With FCM_ENABLED=false put `{}` in it.
FCM_SERVICE_ACCOUNT_FILE_HOST=/opt/workchop-staging/secrets/fcm-service-account.json

# ---- Misc (defaults are fine; shown so nothing the app reads is hidden) -------------
REVERSE_GEOCODE_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=workchop-api/1.0
# Leave unset to rate-limit through REDIS_URL (the stack's own Redis).
# RATE_LIMIT_STORAGE_URI=
# Reviews (PR #9): abusive-language first pass, report limits, response-time window.
REVIEW_ABUSE_FILTER_ENABLED=true
REVIEW_ABUSE_EXTRA_TERMS=
REVIEW_REPORT_IP_RATE_LIMIT=30/hour
REVIEW_REPORTS_PER_USER_PER_HOUR=10
RESPONSE_TIME_WINDOW=20

# ---- Backups (production only: the deploy installs the backup cron there) -------------
# Local dumps are always kept 30 days under $DEPLOY_PATH/backups. Offsite copy is optional:
# ENABLE_CLOUD_BACKUP=true
# CLOUD_PROVIDER=b2            # b2 | gdrive | dropbox | s3  (needs rclone/awscli on the VPS)
# B2_BUCKET=workchop-backups
